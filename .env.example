# Copy to .env.local. Do not commit real values.

# Supabase — read by the app (anon key only; never put the service role here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile — site key is public; secret stays on the server
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google OAuth is not read by this Next.js app.
# Enable the Google provider in the Supabase Auth dashboard and allow
# http://localhost:3000/auth/callback plus the production /auth/callback URL.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend is not called by this repository. Signup codes are sent by Supabase Auth.
# RESEND_API_KEY=
